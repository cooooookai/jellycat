{
  "manifest_version": 3,
  "name": "小水母 & 小黑猫",
  "version": "0.6.1",
  "description": "两个人一起看 B 站：一键去 TA 那里，同一个进度，暂停一起暂停，卡一起卡。",
  "permissions": [
    "storage",
    "tabs",
    "notifications",
    "alarms",
    "idle",
    "scripting"
  ],
  "host_permissions": [
    "*://*.bilibili.com/*",
    "http://127.0.0.1:28787/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.bilibili.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
